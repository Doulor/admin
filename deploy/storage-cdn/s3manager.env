# S3 Manager（Web 控制台）运行时环境（香港 CDN 机）
# 安装位置：/etc/s3manager.env（属主 root，0600；systemd 单元 EnvironmentFile）
#
# ACCESS_KEY_ID / SECRET_ACCESS_KEY 入库时必须为空：真实值只在目标机的这份文件里，
# 由维护者从凭据库注入后手填（见 docs/ops/STORAGE-CDN.md「凭据」），不要写进仓库、镜像或日志。
ENDPOINT=cdn.yangtzeu.work
REGION=garage
USE_SSL=true
BUCKET_LOOKUP=Path
PORT=8080
PUBLIC_URL=https://cdn.yangtzeu.work/{bucket}/{key}
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
